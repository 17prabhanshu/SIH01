# Environment Settings
LOG_LEVEL=INFO
DATA_MODE=LIVE # Options: LIVE, HISTORICAL_REPLAY, CACHED

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landslide_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=landslide_db

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=landslide-data

# External Services
GEE_SERVICE_ACCOUNT=your-gee-service-account@developer.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/path/to/key.json
IMD_API_KEY=your-imd-api-key

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
JWT_SECRET_KEY=your-super-secret-jwt-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Registry
MODEL_REGISTRY_PATH=/path/to/registry
